C 0x86FB hasta cero no se sigue
C 0x86FD el efecto 0x20
C 0x8702 el modo
C 0x8705 el 3 lleva un efecto...
C 0x870B ...el 4 otro...
C 0x8710 ...y los demas el de siempre
L 0x8712 estado_12_suena
C 0x871F color 4 en los cuatro primeros sprites
C 0x872B subir los sprites
C 0x872F y los avisos, a cero
L 0x8735 estado_12_la_rama
