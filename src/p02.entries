# Puntos de entrada del banco 2 (se ejecuta en 0x8000).
#
# Cada uno lleva la instruccion que lo justifica. Los que ponen "pNN:XXXX"
# vienen de OTRO banco: el trazador de una sola pagina no puede seguirlos,
# porque en esa direccion -segun lo que haya en el registro del mapper- puede
# estar cualquiera de cinco bancos. Los que ponen "tabla" salen de una tabla
# del despachador 0x4060, que va pegada detras de su `call` y esta declarada
# como datos en el .nocode: el trazador tampoco puede seguirla.
#
# Los saltos y llamadas DENTRO del propio banco no se ponen aqui: los
# encuentra tools/z80trace.py solo, siguiendo el flujo.
#
# Este fichero lo regenera `make semillas` (tools/bancos.py escribe).
0x8000   # p00:404C call
0x8037   # p02:8014 entrada 0 de la tabla de 0x8017 (call 0x4060 en 0x8014)
0x8060   # p02:8014 entrada 1 de la tabla de 0x8017 (call 0x4060 en 0x8014)
0x8073   # p02:8014 entrada 2 de la tabla de 0x8017 (call 0x4060 en 0x8014)
0x8099   # p02:8014 entrada 3 de la tabla de 0x8017 (call 0x4060 en 0x8014)
0x814B   # p02:8014 entrada 4 de la tabla de 0x8017 (call 0x4060 en 0x8014)
0x81C5   # p02:8014 entrada 5 de la tabla de 0x8017 (call 0x4060 en 0x8014)
0x8278   # p02:8014 entrada 6 de la tabla de 0x8017 (call 0x4060 en 0x8014)
0x83A9   # p02:8014 entrada 7 de la tabla de 0x8017 (call 0x4060 en 0x8014)
0x84E1   # p02:8014 entrada 8 de la tabla de 0x8017 (call 0x4060 en 0x8014)
0x8538   # p02:8014 entrada 9 de la tabla de 0x8017 (call 0x4060 en 0x8014)
0x85D2   # p02:8014 entrada 10 de la tabla de 0x8017 (call 0x4060 en 0x8014)
0x8648   # p02:8014 entrada 11 de la tabla de 0x8017 (call 0x4060 en 0x8014)
0x86C6   # p02:8014 entrada 12 de la tabla de 0x8017 (call 0x4060 en 0x8014)
0x8800   # p02:8014 entrada 13 de la tabla de 0x8017 (call 0x4060 en 0x8014)
