# --- Los accesos a la RAM ya identificada. Los anota tools/anota_ram.py con la
# tabla que ese fichero lleva dentro, y cada entrada de esa tabla dice de donde
# se sabe lo que dice.
C 0x4050 el semaforo de reentrada de la interrupcion
C 0x40FE la FASE, de 1 a 24
C 0x410C el numero de fase tal como se pinta
C 0x4151 la segunda copia del banco de 0x8000, la del sonido
C 0x4157 la segunda copia del banco de 0xA000, la del sonido
C 0x415F la copia en RAM del banco de 0x8000
C 0x4167 la copia en RAM del banco de 0xA000
C 0x4176 la copia en RAM del banco de 0x8000
C 0x4179 la segunda copia del banco de 0xA000, la del sonido
C 0x417F la copia en RAM del banco de 0xA000
C 0x452B la pausa que se hace al perder o al cambiar de fase
C 0x470B por que pareja del guion de la fase va
C 0x472E lo andado en la fase
C 0x4731 por que pareja del guion de la fase va
C 0x473A la copia en RAM del banco de 0x8000
C 0x4744 la copia en RAM del banco de 0xA000
C 0x478F la copia en RAM del banco de 0x8000
C 0x4799 la copia en RAM del banco de 0xA000
C 0x47A3 la copia en RAM del banco de 0x8000
C 0x47AD la copia en RAM del banco de 0xA000
C 0x47CE la copia en RAM del banco de 0x8000
C 0x47D8 la copia en RAM del banco de 0xA000
C 0x49AE el DECORADO, de 0 a 9
C 0x49C4 la tabla de cambio de color, nibble alto
C 0x49EE la tabla de cambio de color, nibble alto
C 0x4A18 la tabla de cambio de color, nibble alto
C 0x4A24 el DECORADO, de 0 a 9
C 0x4A34 la tabla de cambio de color, nibble alto
C 0x4A46 la tabla de cambio de color, nibble alto
C 0x4A61 la tabla de cambio de color, nibble alto
C 0x4BFC el modo en el que esta el juego
C 0x4CD1 el DECORADO, de 0 a 9
C 0x4D12 el DECORADO, de 0 a 9
C 0x4D7F el DECORADO, de 0 a 9
